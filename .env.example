# Required to protect the /admin dashboard
ADMIN_PASSWORD=
# Optional but recommended: separate secret used to sign the admin session cookie.
# Falls back to ADMIN_PASSWORD if unset.
ADMIN_SESSION_SECRET=

# Optional: enables "Preview AI brief" on the design form and auto-generates
# a structured design brief for every submitted order. Without it, that
# feature is skipped gracefully.
ANTHROPIC_API_KEY=

# Optional: enables real deposit payments via Stripe Checkout. Without these,
# the "Pay deposit" button simulates a successful payment (demo mode) so you
# can still exercise the full order flow locally.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional: used to build absolute URLs (e.g. Stripe redirect URLs, the link
# in new-order emails). Defaults to the request's own origin if unset.
NEXT_PUBLIC_BASE_URL=

# Optional: emails you every new design request as soon as it's submitted.
# Sign up at https://resend.com (free tier is plenty to start), grab an API
# key, and set the address you want submissions sent to (your new business
# email, once you've created it — Resend just needs permission to send TO
# it, it doesn't need to be Resend's own inbox).
RESEND_API_KEY=
NOTIFY_EMAIL=
# Sender address Resend sends from. Using their shared onboarding@resend.dev
# works immediately with no setup; verifying your own domain in Resend lets
# you send from e.g. notifications@yourbrand.com instead.
EMAIL_FROM=onboarding@resend.dev
